#!/usr/bin/env ruby
# frozen_string_literal: true

# Единственная точка входа пайплайна умного роутинга.
#
# Использование:
#   bin/route <queue.json> [--out-dir DIR] [--providers PATH] [--config PATH]
#             [--strategy NAME] [--outcomes always_ok|deterministic] [--seed SEED]
#
# Ф3 (CFG-2): поведение задаёт config/routing.yml — bin/route читает его на
# старте, один раз, и передаёт объектом в Routing::Assembly. Ни Planner, ни
# стратегии файловой системы не касаются. Флаг --strategy перекрывает ключ
# strategy из YAML; кода-дефолта стратегии больше нет.
#
# Ф2: Routing::Planner ранжирует каскад стратегией (Routing::Strategies,
# Routing::ShareLedger отслеживает доли по ходу очереди), Execution::Executor
# исполняет через State::Providers, Reporting::DecisionsWriter/ReportBuilder
# пишут оба файла.

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

require 'json'
require 'optparse'
require 'fileutils'
require_relative '../lib/io/providers_loader'
require_relative '../lib/io/queue_loader'
require_relative '../lib/io/history_loader'
require_relative '../lib/config/loader'
require_relative '../lib/routing/assembly'
require_relative '../lib/routing/planner'
require_relative '../lib/routing/share_ledger'
require_relative '../lib/routing/strategies'
require_relative '../lib/state/providers'
require_relative '../lib/execution/executor'
require_relative '../lib/execution/outcome_source/always_ok'
require_relative '../lib/execution/outcome_source/deterministic'
require_relative '../lib/reporting/decisions_writer'
require_relative '../lib/reporting/report_builder'

# CFG-3: каталог стратегий загружается целиком. Новая стратегия — файл в
# lib/routing/strategies/ плюс строка strategy: в конфиге; bin/route править не
# нужно, поимённых require здесь нет намеренно.
Routing::Strategies.load_all!

DECISIONS_FILENAME = 'routing_decisions_test.json'
REPORT_FILENAME = 'routing_report_test.json'
HISTORY_PATH = 'reference/data/operations_history.csv'

def usage
  'Использование: bin/route <queue.json> [--out-dir DIR] [--providers PATH] ' \
    '[--config PATH] [--strategy NAME] [--outcomes NAME] [--seed SEED]'
end

def fail_with(message)
  warn message
  exit 1
end

def add_routing_options(opts, options)
  opts.on('--providers PATH', 'Снапшот провайдеров') { |path| options[:providers_path] = path }
  opts.on('--config PATH', 'Файл конфигурации (по умолчанию config/routing.yml)') do |path|
    options[:config_path] = path
  end
  opts.on('--strategy NAME',
          "Стратегия ранжирования: #{Routing::Strategies.known.join(', ')}") do |name|
    options[:strategy] = name
  end
end

def add_outcome_options(opts, options)
  opts.on('--outcomes NAME', 'Источник исходов: deterministic или always_ok') do |name|
    options[:outcomes] = name
  end
  opts.on('--seed SEED', 'Seed детерминированного источника') { |seed| options[:seed] = seed }
end

def add_options(opts, options)
  opts.on('--out-dir DIR', 'Каталог для выходных файлов (по умолчанию out)') do |dir|
    options[:out_dir] = dir
  end
  add_routing_options(opts, options)
  add_outcome_options(opts, options)
end

def build_option_parser(options)
  OptionParser.new do |opts|
    opts.banner = usage
    add_options(opts, options)
  end
end

def default_options
  # strategy здесь намеренно нет: имя стратегии приходит из конфига, а
  # options[:strategy] остаётся nil, пока не передан --strategy.
  { out_dir: 'out', providers_path: 'reference/data/providers.json',
    config_path: 'config/routing.yml', outcomes: 'deterministic', seed: '42' }
end

def parse_args(argv)
  options = default_options
  parser = build_option_parser(options)
  remaining = parser.parse(argv)
  fail_with("Не указан файл очереди.\n#{usage}") if remaining.empty?

  options[:queue_path] = remaining.first
  options
rescue OptionParser::ParseError => e
  fail_with("Ошибка разбора аргументов: #{e.message}\n#{usage}")
end

def load_providers(path)
  Io::ProvidersLoader.load(path)
rescue RuntimeError => e
  fail_with(e.message)
end

def load_queue(path)
  result = Io::QueueLoader.load(path)
  result.errors.each { |error| warn "очередь: #{error}" }
  result.operations
rescue RuntimeError => e
  fail_with(e.message)
end

def build_outcome_source(options, providers)
  case options[:outcomes]
  when 'always_ok' then Execution::OutcomeSource::AlwaysOk.new
  when 'deterministic'
    conversions = providers.to_h { |provider| [provider.name, provider.conversion_24h.to_f] }
    Execution::OutcomeSource::Deterministic.new(seed: options[:seed], conversions: conversions)
  else
    fail_with("Неизвестный источник исходов #{options[:outcomes].inspect}; " \
              'допустимы deterministic, always_ok')
  end
end

def first_ranked_attempt?(attempt, plan)
  attempt.decision == 'selected' && attempt.attempt_no == 1 && plan.candidates.size > 1
end

def rebuild_attempt(attempt, plan, operation, strategy, ledger)
  provider_name = attempt.provider.respond_to?(:name) ? attempt.provider.name : attempt.provider
  return attempt.with(provider: provider_name) unless first_ranked_attempt?(attempt, plan)

  attempt.with(
    provider: provider_name, reason: 'best_target_adherence',
    details: strategy.explain(plan.candidates, operation, ledger), strategy: strategy.name
  )
end

# Executor не знает про стратегию — переименовывает первую реальную попытку в
# best_target_adherence с объяснением стратегии, когда кандидатов было больше
# одного. Заодно нормализует Attempt#provider: у Executor это объект
# Domain::Provider, а JSON-контракт decisions/report ждёт строку-имя.
def explain_first_attempt(outcome, plan, operation, strategy, ledger)
  attempts = outcome.attempts.map do |attempt|
    rebuild_attempt(attempt, plan, operation, strategy, ledger)
  end
  outcome.with(attempts: attempts)
end

def build_pipeline(providers, options, strategy, fallback_provider)
  state = State::Providers.new(providers)
  {
    planner: Routing::Planner.new(providers: providers, strategy: strategy,
                                  fallback_provider: fallback_provider),
    executor: Execution::Executor.new(outcomes: build_outcome_source(options, providers)),
    state: state,
    ledger: state.shares,
    strategy: strategy
  }
end

def route_operation(operation, pipeline)
  plan = pipeline[:planner].plan(operation, pipeline[:state])
  outcome = pipeline[:executor].run(plan, operation, pipeline[:state])
  explained = explain_first_attempt(
    outcome, plan, operation, pipeline[:strategy], pipeline[:ledger]
  )
  [operation, explained]
end

def build_pairs(operations, providers, options, inputs)
  pipeline = build_pipeline(providers, options, inputs[:strategy],
                            inputs[:config].fallback_provider)
  operations.map { |operation| route_operation(operation, pipeline) }
end

def write_outputs(out_dir, pairs, providers, history, strategy)
  FileUtils.mkdir_p(out_dir)
  decisions_path = File.join(out_dir, DECISIONS_FILENAME)
  report_path = File.join(out_dir, REPORT_FILENAME)

  Reporting::DecisionsWriter.write(decisions_path, pairs)
  Reporting::ReportBuilder.write(
    report_path, pairs, providers: providers, history: history, strategy: strategy.name
  )

  [decisions_path, report_path]
end

# Config::SchemaError наследует RuntimeError: битый или отсутствующий конфиг
# должен давать сообщение и код 1, а не трейс.
def load_config(path)
  Config::Loader.load(path)
rescue RuntimeError => e
  fail_with(e.message)
end

# Слои в Ф3 не применяются: реестр пуст. Непустой layers обязан ронять запуск,
# иначе фича выглядит существующей, ничего не меняя.
def build_strategy(config, override)
  Routing::Assembly.layers(config: config)
  Routing::Assembly.strategy(config: config, override: override)
rescue KeyError => e
  fail_with(e.message)
end

def load_inputs(options)
  config = load_config(options[:config_path])
  {
    providers: load_providers(options[:providers_path]),
    operations: load_queue(options[:queue_path]),
    history: Io::HistoryLoader.load(HISTORY_PATH),
    config: config,
    strategy: build_strategy(config, options[:strategy])
  }
end

def main(argv)
  options = parse_args(argv)
  inputs = load_inputs(options)

  pairs = build_pairs(inputs[:operations], inputs[:providers], options, inputs)
  decisions_path, report_path = write_outputs(
    options[:out_dir], pairs, inputs[:providers], inputs[:history], inputs[:strategy]
  )

  puts "Прочитано операций: #{inputs[:operations].size}"
  puts "Записано: #{decisions_path}"
  puts "Записано: #{report_path}"
end

main(ARGV) if $PROGRAM_NAME == __FILE__
