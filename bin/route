#!/usr/bin/env ruby
# frozen_string_literal: true

# Единственная точка входа пайплайна умного роутинга.
#
# Использование:
#   bin/route <queue.json> [--out-dir DIR] [--providers PATH] [--config PATH]
#             [--history PATH] [--strategy NAME] [--outcomes NAME] [--seed SEED]
#             [--script PATH]
#             [--[no-]offline-analytics]
#
# Источники исходов: deterministic (боевой, хеш от seed), scripted (исход каждой
# пары задан в YAML — для демо и разбора конкретного случая), always_ok и
# always_fail (вырожденные, для тестов каскада).
#
# Офлайн-аналитика (оракул + сравнение конфигураций, lib/offline/*) не влияет
# ни на одно решение и стоит десятки секунд на больших очередях (см. комментарий
# у OFFLINE_ANALYTICS_MAX_OPS_DEFAULT ниже). Выше порога offline_analytics.max_operations
# из конфига она не считается по умолчанию; --offline-analytics/--no-offline-analytics
# перекрывает порог в обе стороны, как --oracle в bin/bench.
#
# Поведение задаёт config/routing.yml — bin/route читает его на старте, один
# раз, и передаёт объектом в Routing::Assembly. Ни Planner, ни стратегии
# файловой системы не касаются. Флаг --strategy перекрывает ключ strategy из
# YAML; кода-дефолта стратегии нет.
#
# Routing::Planner ранжирует каскад стратегией (Routing::Strategies,
# Routing::ShareLedger отслеживает доли по ходу очереди), Execution::Executor
# исполняет через State::Providers, Reporting::DecisionsWriter/ReportBuilder
# пишут оба файла.

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

require 'json'
require 'optparse'
require 'fileutils'
require_relative '../lib/io/providers_loader'
require_relative '../lib/io/provider_overrides'
require_relative '../lib/io/queue_loader'
require_relative '../lib/io/history_loader'
require_relative '../lib/config/loader'
require_relative '../lib/routing/assembly'
require_relative '../lib/routing/planner'
require_relative '../lib/routing/share_ledger'
require_relative '../lib/routing/strategies'
require_relative '../lib/state/providers'
require_relative '../lib/execution/executor'
require_relative '../lib/execution/pending_resolver'
require_relative '../lib/execution/pending_resolution_pass'
require_relative '../lib/execution/outcome_source/always_ok'
require_relative '../lib/execution/outcome_source/deterministic'
require_relative '../lib/execution/outcome_source/always_fail'
require_relative '../lib/execution/outcome_source/scripted'
require_relative '../lib/reporting/decisions_writer'
require_relative '../lib/reporting/report_builder'
require_relative '../lib/reporting/utilization'
require_relative '../lib/reporting/pending_resolution_summary'
require_relative '../lib/reporting/console_summary'
require_relative '../lib/reporting/outcome_distribution'
require_relative '../lib/reporting/latency_profile'
require_relative '../lib/reporting/queue_coverage'
require_relative '../lib/reporting/input_diagnostics'
require_relative '../lib/reporting/amount_bands'
require_relative '../lib/reporting/recommendation_effect'
require_relative '../lib/offline/objective'
require_relative '../lib/offline/oracle'
require_relative '../lib/offline/benchmark_block'
require_relative '../lib/offline/comparison'

# Каталог стратегий загружается целиком. Новая стратегия — файл в
# lib/routing/strategies/ плюс строка strategy: в конфиге; bin/route править не
# нужно, поимённых require здесь нет намеренно.
Routing::Strategies.load_all!
Routing::Layers.load_all!

DECISIONS_FILENAME = 'routing_decisions_test.json'
REPORT_FILENAME = 'routing_report_test.json'

# Порог размера очереди, выше которого офлайн-эталон (Offline::Oracle) и
# офлайн-сравнение конфигураций (Offline::Comparison) не считаются по
# умолчанию. Обоснование из замеров (пакет 4, 100 000 операций, реальные
# data/providers.json): полный прогон 28.6 с, из них 20 с (70%) — офлайн-
# аналитика (оракул 7.9 с, сравнение трёх конфигураций 12.1 с), которая не
# входит ни в одно решение. На 10 000 операций та же аналитика укладывается в
# единицы секунд и не мешает демонстрации — отсюда порог. Совпадает с
# ORACLE_AUTO_MAX_OPS в bin/bench намеренно: те же порядки величин, тот же
# смысл границы, держим согласованно.
#
# Значение — только дефолт на отсутствующий ключ конфига offline_analytics.max_operations
# (Config::SchemaRules.validate_offline_analytics!); реальный порог правится
# в config/routing.yml без изменения кода.
OFFLINE_ANALYTICS_MAX_OPS_DEFAULT = 10_000

def usage
  'Использование: bin/route <queue.json> [--out-dir DIR] [--providers PATH] ' \
    '[--config PATH] [--strategy NAME] [--outcomes NAME] [--seed SEED]'
end

def fail_with(message)
  warn message
  exit 1
end

# Пути входов отдельно от поведения: в час стопкода организаторы могут выдать
# свой снапшот провайдеров и свою историю вместе с очередью, и все три подмены
# обязаны делаться флагами, без правки боевого конфига (docs/RUNBOOK.md, шаг 2).
def add_input_options(opts, options)
  opts.on('--providers PATH', 'Снапшот провайдеров') { |path| options[:providers_path] = path }
  opts.on('--history PATH', 'История операций (по умолчанию history_path из конфига)') do |path|
    options[:history_path] = path
  end
  opts.on('--config PATH', 'Файл конфигурации (по умолчанию config/routing.yml)') do |path|
    options[:config_path] = path
  end
end

def add_routing_options(opts, options)
  opts.on('--strategy NAME',
          "Стратегия ранжирования: #{Routing::Strategies.known.join(', ')}") do |name|
    options[:strategy] = name
  end
  opts.on('--set KEY=VALUE', 'Временно переопределить существующую настройку') do |expression|
    options[:overrides] << expression
  end
end

def add_outcome_options(opts, options)
  opts.on('--outcomes NAME',
          'Источник исходов: deterministic, always_ok, always_fail, scripted') do |name|
    options[:outcomes] = name
  end
  opts.on('--seed SEED', 'Seed детерминированного источника') { |seed| options[:seed] = seed }
  opts.on('--script PATH', 'YAML со сценарием исходов (для --outcomes scripted)') do |path|
    options[:script] = path
  end
end

def add_options(opts, options)
  opts.on('--out-dir DIR', 'Каталог для выходных файлов (по умолчанию out)') do |dir|
    options[:out_dir] = dir
  end
  add_input_options(opts, options)
  add_routing_options(opts, options)
  add_outcome_options(opts, options)
  opts.on('--[no-]offline-analytics',
          'Оракул + сравнение конфигураций поверх порога offline_analytics.max_operations') do |v|
    options[:offline_analytics] = v
  end
end

def build_option_parser(options)
  OptionParser.new do |opts|
    opts.banner = usage
    add_options(opts, options)
  end
end

def default_options
  # strategy здесь намеренно нет: имя стратегии приходит из конфига, а
  # options[:strategy] остаётся nil, пока не передан --strategy.
  #
  # providers_path по умолчанию — наш расширенный снапшот data/providers.json
  # (побайтовая копия снапшота организаторов
  # плюс volume_share_pct/daily_turnover_min/daily_turnover_max), а не
  # reference/data/providers.json. Пристинный файл организаторов остаётся
  # эталоном допуска для make validate; --providers reference/data/providers.json
  # по-прежнему доступен явным флагом.
  # offline_analytics: nil -- как strategy, приоритет флагу отдаётся только
  # когда он реально передан (see offline_analytics_enabled? ниже); nil здесь
  # означает «решает порог из конфига», а не «выключено».
  { out_dir: 'out', providers_path: 'data/providers.json',
    config_path: 'config/routing.yml', outcomes: nil, seed: nil, offline_analytics: nil,
    history_path: nil, overrides: [] }
end

def parse_args(argv)
  options = default_options
  parser = build_option_parser(options)
  remaining = parser.parse(argv)
  fail_with("Не указан файл очереди.\n#{usage}") if remaining.empty?

  options[:queue_path] = remaining.first
  options
rescue OptionParser::ParseError => e
  fail_with("Ошибка разбора аргументов: #{e.message}\n#{usage}")
end

def load_providers(path)
  Io::ProvidersLoader.load(path)
rescue RuntimeError => e
  fail_with(e.message)
end

# obligations/rate_limits из конфига — override поверх снапшота, применяется
# после warn_unapplied_config (которая честно смотрит на провайдеров ДО
# наложения override — на data/providers.json оба поля уже реальны, так что
# предупреждение не печатается; на пристинном reference/data/providers.json
# печатается по-прежнему).
def apply_overrides(providers, config)
  extra = config.providers_extra_path ? Io::ProviderOverrides.load_extra(config.providers_extra_path) : {}
  Io::ProviderOverrides.apply(providers, obligations: config.obligations,
                                         rate_limits: config.rate_limits,
                                         providers_overrides: extra.merge(config.providers))
rescue RuntimeError => e
  fail_with(e.message)
end

# smoothing читается здесь же, а не в outcome_conversions -- outcomes.smoothing
# управляет самим расчётом Io::HistoryStats (используется и стратегией
# conversion, и отчётом), а не только порогами Deterministic.
def load_history(path, config)
  Io::HistoryLoader.load(path, smoothing: config.outcomes.fetch('smoothing', true))
rescue RuntimeError => e
  fail_with(e.message)
end

def load_queue(path)
  result = Io::QueueLoader.load(path)
  result.errors.each { |error| warn "очередь: #{error}" }
  result
rescue RuntimeError => e
  fail_with(e.message)
end

# rubocop:disable-next Metrics/MethodLength -- выбор источника и приоритет значений конфигурации видны вместе.
def build_outcome_source(options, providers, config, history)
  case outcome_source_name(options, config)
  when 'always_ok' then Execution::OutcomeSource::AlwaysOk.new
  when 'always_fail' then Execution::OutcomeSource::AlwaysFail.new
  when 'scripted' then build_scripted_source(options, config)
  when 'deterministic'
    Execution::OutcomeSource::Deterministic.new(
      seed: outcome_seed(options, config),
      outcome_table: outcome_table(config, providers, history)
    )
  else
    fail_with("Неизвестный источник исходов #{outcome_source_name(options, config).inspect}; " \
              "допустимы #{Config::SchemaRules::OUTCOME_SOURCES.join(', ')}")
  end
end

# Сценарный источник: исход каждой пары (операция, провайдер) задан явно.
# Нужен для демо и разбора конкретного случая — «провайдер отказывает, смотрим
# каскад» без подбора seed, на котором SHA256 случайно даст нужный исход.
#
# Сценарий берётся из outcomes.script в конфиге: либо отображением прямо там
# (основная форма — это такая же настройка, как стратегия), либо строкой-путём
# к отдельному YAML. Флаг --script перекрывает конфиг и всегда означает путь.
def build_scripted_source(options, config)
  script = options[:script] || config.outcomes['script']
  fail_with('Источник scripted требует сценарий: outcomes.script в конфиге или --script PATH') if
    script.nil?
  return Execution::OutcomeSource::Scripted.new(script: script) if script.is_a?(Hash)

  load_script_file(script)
end

def load_script_file(path)
  fail_with("Файл сценария не найден: #{path}") unless File.exist?(path)

  Execution::OutcomeSource::Scripted.load(path)
rescue Psych::SyntaxError => e
  fail_with("Сценарий #{path}: невалидный YAML — #{e.message}")
end

def outcome_source_name(options, config)
  options[:outcomes] || config.outcomes.fetch('source', 'deterministic')
end

def outcome_seed(options, config)
  options[:seed] || config.outcomes.fetch('seed', '42')
end

# Значения уже прошли Config::SchemaError на этапе загрузки конфига
# (SchemaRules.validate_cascade!), поэтому здесь только дефолт на
# отсутствующий подключ -- как outcome_source_name/outcome_seed выше.
#
# Дефолты -- last_candidate и stop, как в самом config/routing.yml (см.
# комментарий у cascade: там -- это факт, проверенный reference_decisions.json
# и `make validate`, а не вкусовой выбор). Должны совпадать с дефолтами в
# config/routing.yml -- расхождение молча меняет боевое поведение мимо конфига.
def cascade_exhausted(config) = config.cascade.fetch('exhausted', 'last_candidate').to_sym

def cascade_on_timeout(config) = config.cascade.fetch('on_timeout', 'stop').to_sym

# calibrate_from_history: true -- outcome_table из Io::HistoryStats (уже
# сглаженные approved_bp/rejected_bp на провайдера, Io::HistoryLoader),
# наложенные ПОВЕРХ паспортной таблицы, а не вместо неё. spacepayments в
# operations_history.csv нет вовсе (это self-provider фолбэка, а не участник
# обычного каскада) -- без паспортной подложки он получил бы скалярный
# дефолт Execution::OutcomeSource::Deterministic::DEFAULT_OUTCOME (approved_bp:
# 0), то есть НИКОГДА не одобрял бы, что превращает предсказуемый
# "фолбэк почти всегда approved" в подобие ещё одного ненадёжного провайдера.
# Паспортная таблица строится для ВСЕХ провайдеров снапшота заранее и
# перекрывается калиброванными записями только там, где история реально есть.
def outcome_table(config, providers, history)
  passport = Execution::OutcomeSource::Deterministic.passport_outcome_table(providers)
  return passport unless config.outcomes.fetch('calibrate_from_history', false)

  passport.merge(history.to_outcome_table)
end

def first_ranked_attempt?(attempt, plan)
  attempt.decision == 'selected' && attempt.attempt_no == 1 && plan.candidates.size > 1
end

def rebuild_attempt(attempt, plan, operation, strategy, ledger)
  provider_name = attempt.provider.respond_to?(:name) ? attempt.provider.name : attempt.provider
  return attempt.with(provider: provider_name) unless first_selected_attempt?(attempt, plan)

  details = attempt_details(plan, operation, strategy, ledger)
  attributes = { provider: provider_name, details: details, strategy: plan.trace.strategy_name }
  attributes[:reason] = 'best_target_adherence' if first_ranked_attempt?(attempt, plan)
  attempt.with(**attributes)
end

def first_selected_attempt?(attempt, plan)
  attempt.decision == 'selected' && attempt.attempt_no == 1 && !plan.trace.nil?
end

def attempt_details(plan, operation, strategy, ledger)
  return plan.trace.details unless plan.trace.segments.one?

  strategy.explain(plan.candidates, operation, ledger)
end

# Executor не знает про стратегию — переименовывает первую реальную попытку в
# best_target_adherence с объяснением стратегии, когда кандидатов было больше
# одного. Заодно нормализует Attempt#provider: у Executor это объект
# Domain::Provider, а JSON-контракт decisions/report ждёт строку-имя.
def explain_first_attempt(outcome, plan, operation, strategy, ledger)
  attempts = outcome.attempts.map do |attempt|
    rebuild_attempt(attempt, plan, operation, strategy, ledger)
  end
  outcome.with(attempts: attempts)
end

# rubocop:disable-next Metrics/ParameterLists, Metrics/MethodLength -- части пайплайна приходят из независимых источников.
def build_pipeline(providers, options, strategy, selector, fallback_provider, layers,
                   config, history)
  state = State::Providers.new(providers)
  outcomes = build_outcome_source(options, providers, config, history)
  {
    planner: Routing::Planner.new(providers: providers, strategy: strategy, selector: selector,
                                  fallback_provider: fallback_provider,
                                  layers: Routing::LayerStack.new(layers)),
    executor: Execution::Executor.new(outcomes: outcomes, exhausted: cascade_exhausted(config),
                                      on_timeout: cascade_on_timeout(config)),
    outcomes: outcomes,
    state: state,
    ledger: state.shares,
    strategy: strategy
  }
end

def route_operation(operation, pipeline)
  plan = pipeline[:planner].plan(operation, pipeline[:state])
  outcome = pipeline[:executor].run(plan, operation, pipeline[:state])
  explained = explain_first_attempt(
    outcome, plan, operation, pipeline[:strategy], pipeline[:ledger]
  )
  [operation, explained]
end

def build_pairs(operations, providers, options, inputs)
  pipeline = build_pipeline(providers, options, inputs[:strategy], inputs[:selector],
                            inputs[:config].fallback_provider, inputs[:layers],
                            inputs[:config], inputs[:history])
  pairs = operations.map { |operation| route_operation(operation, pipeline) }
  [pairs, pipeline[:outcomes], pipeline[:state]]
end

# Дефолт -- включено, обоснование в комментарии у ключа pending_resolution в
# config/routing.yml. Здесь -- только дефолт на отсутствующий подключ
# enabled, как offline_analytics_enabled?/cascade_exhausted выше.
def pending_resolution_enabled?(config)
  config.pending_resolution.fetch('enabled', true)
end

# Второй проход строго после всей очереди (вызывается из main уже после
# build_pairs целиком) -- решения первого прохода в pairs не трогает, только
# читает их, чтобы найти held-резервы, и мутирует state, освобождая ёмкость.
# utilization_before -- тот же расчёт, что уже идёт в основной отчёт
# (projected_daily_utilization), взятый ДО статус-чека, чтобы секция отчёта
# показывала дельту, а не пересчитывала первый проход заново.
def build_pending_resolution(pairs, state, outcomes, providers)
  utilization_before = Reporting::Utilization.projected_daily(pairs, providers)
  report = Execution::PendingResolutionPass.new(outcomes: outcomes, providers: providers)
                                           .call(pairs, state)
  Reporting::PendingResolutionSummary.build(report, utilization_before, providers)
end

def maybe_build_pending_resolution(pairs, state, outcomes, inputs)
  return nil unless pending_resolution_enabled?(inputs[:config])

  build_pending_resolution(pairs, state, outcomes, inputs[:providers])
end

# rubocop:disable-next Metrics/ParameterLists -- сформированные секции отчёта передаются явно.
def write_outputs(out_dir, pairs, providers, history, strategy, benchmark: nil, comparison: nil,
                  pending_resolution: nil, report_sections: {})
  FileUtils.mkdir_p(out_dir)
  decisions_path = File.join(out_dir, DECISIONS_FILENAME)
  report_path = File.join(out_dir, REPORT_FILENAME)

  Reporting::DecisionsWriter.write(decisions_path, pairs)
  Reporting::ReportBuilder.write(
    report_path, pairs, providers: providers, history: history, strategy: strategy.name,
                        benchmark: benchmark, comparison: comparison,
                        pending_resolution: pending_resolution, report_sections: report_sections
  )

  [decisions_path, report_path]
end

# Порог решает офлайн_аналитику целиком (и оракул, и comparison) -- обе части
# дорогие сами по себе (см. OFFLINE_ANALYTICS_MAX_OPS_DEFAULT) и обе не влияют
# ни на одно решение, отключать их порознь незачем. Приоритет источников как
# у остальных override в этом файле (--strategy, --seed): флаг CLI, если он
# передан явно, > YAML > дефолт в коде.
def offline_analytics_max_ops(config)
  config.offline_analytics.fetch('max_operations', OFFLINE_ANALYTICS_MAX_OPS_DEFAULT)
end

def offline_analytics_enabled?(options, config, total_operations)
  return options[:offline_analytics] unless options[:offline_analytics].nil?

  total_operations <= offline_analytics_max_ops(config)
end

# Пропуск обязан быть виден: строка в STDOUT (этот метод) и явная пометка в
# самом отчёте (skipped_offline_analytics_benchmark ниже) -- отчёт, где секция
# молча исчезла, хуже отчёта, где написано, почему её нет.
def warn_offline_analytics_skipped(total_operations, max_ops)
  puts 'офлайн-аналитика (эталон + сравнение конфигураций) пропущена: ' \
       "#{total_operations} операций > порога #{max_ops} " \
       '(offline_analytics.max_operations в конфиге); включить явно -- флаг --offline-analytics'
end

def offline_analytics_skip_note(total_operations, max_ops)
  "эталон и сравнение конфигураций не считались: #{total_operations} операций " \
    "больше порога #{max_ops} (offline_analytics.max_operations); включить явно -- " \
    'флаг --offline-analytics'
end

# Та же форма секции benchmark, что и у Offline::BenchmarkBlock (offline_bound/
# our_online_result/competitive_ratio/note), плюс структурные поля причины --
# status/total_operations/max_operations считываются программно, а не только
# из текста note. comparison в этом случае -- nil (build_comparison уже умеет
# такое для пустого ключа `comparison` в конфиге, здесь используется тот же
# путь: секции в отчёте нет вовсе).
def skipped_offline_analytics_benchmark(total_operations, max_ops)
  {
    'offline_bound' => nil, 'our_online_result' => nil, 'competitive_ratio' => nil,
    'status' => 'skipped_queue_too_large', 'total_operations' => total_operations,
    'max_operations' => max_ops,
    'note' => offline_analytics_skip_note(total_operations, max_ops)
  }
end

# rubocop:disable-next Metrics/MethodLength, Metrics/AbcSize
def build_benchmark(pairs, inputs, outcomes, options)
  online_assignment = Offline::Oracle.online_assignment(pairs)
  ours = Offline::Objective.from_pairs(pairs, providers: inputs[:providers])
  oracle = Offline::Oracle.new(
    providers: inputs[:providers], operations: inputs[:operations], outcomes: outcomes,
    fallback_provider: inputs[:config].fallback_provider, online_metrics: ours
  )
  bound = oracle.call(online_assignment)
  Offline::BenchmarkBlock.build(
    bound: bound.metrics, ours: ours, total: inputs[:operations].size,
    seed: outcome_seed(options, inputs[:config]),
    local_search_skipped: inputs[:operations].size > Offline::Oracle::LOCAL_SEARCH_MAX_OPS
  )
end

# comparison считается один раз здесь и передаётся кому угодно готовым хешем
# (как benchmark) -- ReportBuilder внутри
# ничего не гоняет (spec/reporting/report_builder_spec.rb). Пустой/отсутствующий
# ключ comparison в конфиге -- законный вход: секции в отчёте нет вовсе.
def build_comparison(inputs)
  return nil if inputs[:config].comparison.empty?

  Offline::Comparison.build(
    variants: inputs[:config].comparison, operations: inputs[:operations],
    providers: inputs[:providers], config: inputs[:config], history: inputs[:history],
    baseline: comparison_baseline_name(inputs[:config])
  )
end

# Config::SchemaRules.validate_comparison! уже гарантировал на загрузке
# конфига, что ровно такой вариант существует -- здесь просто находим его имя.
def comparison_baseline_name(config)
  config.comparison.find do |variant|
    variant['strategy'] == config.strategy && variant.fetch('layers', []) == config.layers
  end.fetch('name')
end

# Config::SchemaError наследует RuntimeError: битый или отсутствующий конфиг
# должен давать сообщение и код 1, а не трейс.
def load_config(path, overrides = [])
  Config::Loader.load(path, overrides: overrides)
rescue RuntimeError => e
  fail_with(e.message)
end

# Слои по умолчанию не применяются: реестр пуст. Непустой layers обязан
# ронять запуск, иначе фича выглядит существующей, ничего не меняя.
def build_layers(config)
  Routing::Assembly.layers(config: config)
rescue KeyError => e
  fail_with(e.message)
end

def build_strategy(config, override, history)
  Routing::Assembly.strategy(config: config, override: override, history: history)
rescue KeyError => e
  fail_with(e.message)
end

def build_selector(config, override, history)
  Routing::Assembly.selector(config: config, override: override, history: history)
rescue KeyError, ArgumentError => e
  fail_with(e.message)
end

# providers здесь — снапшот ДО apply_overrides. data/providers.json несёт
# daily_turnover_min/max и requests_per_minute_limit, поэтому обе проверки
# ниже больше не печатают предупреждение на дефолтном снапшоте; на пристинном
# reference/data/providers.json (флаг --providers) оба предупреждения
# печатаются по-прежнему.
def warn_unapplied_config(config, providers)
  warn_missing_provider_field(config.rate_limits, providers, :requests_per_minute_limit,
                              'rate_limits', 'requests_per_minute_limit')
  warn_missing_provider_field(config.obligations, providers, :daily_turnover_min,
                              'obligations', 'daily_turnover_min/daily_turnover_max')
end

def warn_missing_provider_field(rules, providers, field, key, snapshot_field)
  return if rules.empty? || providers.any? { |provider| !provider.public_send(field).nil? }

  names = rules.keys.sort.join(', ')
  warn "конфиг: #{key} заданы для #{names} — в снапшоте провайдеров нет поля " \
       "#{snapshot_field}, правило не применяется"
end

# rubocop:disable-next Metrics/MethodLength -- загрузка входов и предупреждения делаются единожды до цикла очереди.
# rubocop:disable-next Metrics/AbcSize
def load_inputs(options)
  config = load_config(options[:config_path], options[:overrides])
  raw_providers = load_providers(options[:providers_path])
  warn_unapplied_config(config, raw_providers)
  providers = apply_overrides(raw_providers, config)
  # История читается один раз здесь и раздаётся всем, кому нужна: источнику
  # исходов (пороги конверсии), стратегии conversion (порядок кандидатов) и
  # отчёту. Путь берётся из конфига (ключ history_path) либо из флага --history:
  # в час стопкода организаторы могут выдать свою историю, и правка боевого
  # конфига под дедлайном — худший момент для правки боевого конфига.
  history = load_history(options[:history_path] || config.history_path, config)
  {
    providers: providers,
    queue: load_queue(options[:queue_path]),
    history: history,
    config: config,
    layers: build_layers(config),
    strategy: build_strategy(config, options[:strategy], history),
    selector: build_selector(config, options[:strategy], history)
  }
end

# Секции строятся у границы пайплайна: здесь доступны исходные загрузчики,
# тогда как ReportBuilder только собирает уже готовые данные в стабильный JSON.
# rubocop:disable-next Metrics/AbcSize, Metrics/MethodLength -- секции собираются явно в одном месте границы пайплайна.
def build_report_sections(pairs, inputs, history_path, include_recommendation_effect: true)
  # В отчёте достаточно имени файла: абсолютный путь флага не должен менять
  # содержимое при ссылке на ту же историю из конфигурации.
  source = File.basename(history_path || inputs[:config].history_path)
  sections = {
    'outcome_distribution' => Reporting::OutcomeDistribution.build(inputs[:history], source),
    'queue_coverage' => Reporting::QueueCoverage.build(inputs[:queue], pairs),
    'input_diagnostics' => Reporting::InputDiagnostics.build(inputs[:queue], inputs[:history],
                                                             inputs[:providers]),
    'amount_bands' => Reporting::AmountBands.build(pairs, inputs[:history])
  }
  if include_recommendation_effect
    sections['recommendation_effect'] = Reporting::RecommendationEffect.build(
      pairs, operations: inputs[:operations], providers: inputs[:providers],
             config: inputs[:config], history: inputs[:history]
    )
  end
  latency = Reporting::LatencyProfile.build(inputs[:history], source)
  latency.nil? ? sections : sections.merge('latency_profile' => latency)
end

# Гейт для дорогой офлайн-аналитики целиком (см. offline_analytics_enabled?).
# Ниже порога -- поведение как раньше, benchmark/comparison настоящие. Выше
# порога и без явного --offline-analytics -- benchmark несёт пометку причины
# (status: skipped_queue_too_large), comparison -- nil (та же законная форма
# отсутствия секции, что и у пустого ключа `comparison` в конфиге).
def build_offline_analytics(pairs, inputs, outcomes, options)
  total = inputs[:operations].size
  return [build_benchmark(pairs, inputs, outcomes, options), build_comparison(inputs)] if
    offline_analytics_enabled?(options, inputs[:config], total)

  max_ops = offline_analytics_max_ops(inputs[:config])
  warn_offline_analytics_skipped(total, max_ops)
  [skipped_offline_analytics_benchmark(total, max_ops), nil]
end

# rubocop:disable-next Metrics/AbcSize, Metrics/MethodLength
def main(argv)
  options = parse_args(argv)
  inputs = load_inputs(options)

  inputs[:operations] = inputs[:queue].operations
  pairs, outcomes, state = build_pairs(inputs[:operations], inputs[:providers], options, inputs)
  pending_resolution = maybe_build_pending_resolution(pairs, state, outcomes, inputs)
  benchmark, comparison = build_offline_analytics(pairs, inputs, outcomes, options)
  decisions_path, report_path = write_outputs(
    options[:out_dir], pairs, inputs[:providers], inputs[:history], inputs[:strategy],
    benchmark: benchmark, comparison: comparison, pending_resolution: pending_resolution,
    report_sections: build_report_sections(
      pairs, inputs, options[:history_path],
      include_recommendation_effect: offline_analytics_enabled?(
        options, inputs[:config], inputs[:operations].size
      )
    )
  )

  print_console_summary(pairs, inputs, benchmark, comparison, pending_resolution, options)

  puts "Прочитано операций: #{inputs[:operations].size}"
  puts "Записано: #{decisions_path}"
  puts "Записано: #{report_path}"
end

# Report строится второй раз намеренно -- .write (в write_outputs) уже
# построил и отбросил свой экземпляр. Дорогая часть (офлайн-оракул и
# офлайн-сравнение) в benchmark/comparison уже посчитана один раз в
# build_benchmark/build_comparison и передаётся сюда готовыми хешами,
# повторно не считается -- пересчитывается только дешёвая часть
# (distribution/achievable/deviation_causes/recommendations). pending_resolution
# тоже готовый хеш (или nil, когда второй проход выключен) -- второй проход
# по held-резервам здесь не повторяется, он мутировал state один раз в main.
# rubocop:disable-next Metrics/MethodLength, Metrics/ParameterLists -- CLI boundary passes completed pipeline values explicitly.
def print_console_summary(pairs, inputs, benchmark, comparison, pending_resolution, options)
  report = Reporting::ReportBuilder.build(
    pairs, providers: inputs[:providers], history: inputs[:history],
           strategy: inputs[:strategy].name, benchmark: benchmark, comparison: comparison,
           pending_resolution: pending_resolution,
           report_sections: build_report_sections(
             pairs, inputs, nil,
             include_recommendation_effect: offline_analytics_enabled?(
               options, inputs[:config], inputs[:operations].size
             )
           )
  )

  Reporting::ConsoleSummary.operation_lines(pairs).each { |line| puts line }
  Reporting::ConsoleSummary.summary_lines(report).each { |line| puts line }
end

main(ARGV) if $PROGRAM_NAME == __FILE__
