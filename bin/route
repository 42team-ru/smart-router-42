#!/usr/bin/env ruby
# frozen_string_literal: true

# Единственная точка входа пайплайна умного роутинга.
#
# Использование:
#   bin/route <queue.json> [--out-dir DIR] [--providers PATH] [--outcomes always_ok|deterministic]
#
# Ф2: настоящий пайплайн — Routing::Planner строит каскад, Execution::Executor
# исполняет его через State::Providers, Reporting::DecisionsWriter/ReportBuilder
# пишут оба файла. outcomes: always_ok по умолчанию (совпадает с тем, как
# провалидированы 4 эталонных кейса организаторов), deterministic — для
# содержательного прогона approved/rejected/expired на боевой очереди.

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

require 'json'
require 'optparse'
require 'fileutils'
require_relative '../lib/io/providers_loader'
require_relative '../lib/io/queue_loader'
require_relative '../lib/io/history_loader'
require_relative '../lib/routing/planner'
require_relative '../lib/execution/executor'
require_relative '../lib/execution/outcome_source/always_ok'
require_relative '../lib/execution/outcome_source/deterministic'
require_relative '../lib/state/providers'
require_relative '../lib/reporting/decisions_writer'
require_relative '../lib/reporting/report_builder'

DECISIONS_FILENAME = 'routing_decisions_test.json'
REPORT_FILENAME = 'routing_report_test.json'
HISTORY_PATH = 'reference/data/operations_history.csv'
# Не seed из времени/окружения — иначе make determinism не совпадёт побайтово.
DETERMINISTIC_SEED = 'smart-router-42'

def usage
  'Использование: bin/route <queue.json> [--out-dir DIR] [--providers PATH] ' \
    '[--outcomes always_ok|deterministic]'
end

def fail_with(message)
  warn message
  exit 1
end

def add_options(opts, options)
  opts.on('--out-dir DIR', 'Каталог для выходных файлов (по умолчанию out)') do |dir|
    options[:out_dir] = dir
  end
  opts.on('--providers PATH', 'Снапшот провайдеров') do |path|
    options[:providers_path] = path
  end
  opts.on('--outcomes SOURCE', %w[always_ok deterministic],
          'Источник исходов исполнения (always_ok по умолчанию)') do |source|
    options[:outcomes] = source
  end
end

def build_option_parser(options)
  OptionParser.new do |opts|
    opts.banner = usage
    add_options(opts, options)
  end
end

def default_options
  { out_dir: 'out', providers_path: 'reference/data/providers.json', outcomes: 'always_ok' }
end

def parse_args(argv)
  options = default_options
  parser = build_option_parser(options)

  begin
    remaining = parser.parse(argv)
  rescue OptionParser::ParseError => e
    fail_with("Ошибка разбора аргументов: #{e.message}\n#{usage}")
  end

  fail_with("Не указан файл очереди.\n#{usage}") if remaining.empty?

  options[:queue_path] = remaining.first
  options
end

def load_providers(path)
  Io::ProvidersLoader.load(path)
rescue RuntimeError => e
  fail_with(e.message)
end

def load_queue(path)
  result = Io::QueueLoader.load(path)
  result.errors.each { |error| warn "очередь: #{error}" }
  result.operations
rescue RuntimeError => e
  fail_with(e.message)
end

def build_outcome_source(name, providers)
  return Execution::OutcomeSource::AlwaysOk.new unless name == 'deterministic'

  conversions = providers.to_h { |provider| [provider.name, provider.conversion_24h] }
  Execution::OutcomeSource::Deterministic.new(seed: DETERMINISTIC_SEED, conversions: conversions)
end

# Attempt#provider у настоящего Outcome — объект Domain::Provider (см. Executor/Violation),
# а JSON-контракт decisions/report ждёт строку-имя. Нормализуем на границе интеграции, не
# трогая замороженный формат Attempt.
def normalize_outcome(outcome)
  attempts = outcome.attempts.map do |attempt|
    next attempt unless attempt.provider.respond_to?(:name)

    attempt.with(provider: attempt.provider.name)
  end
  outcome.with(attempts: attempts)
end

def route_operation(operation, planner, executor, state)
  plan = planner.plan(operation, state)
  outcome = executor.run(plan, operation, state)
  [operation, normalize_outcome(outcome)]
end

def build_pairs(operations, providers, outcomes_source)
  planner = Routing::Planner.new(providers: providers)
  executor = Execution::Executor.new(outcomes: outcomes_source)
  state = State::Providers.new(providers)

  operations.map { |operation| route_operation(operation, planner, executor, state) }
end

def write_outputs(out_dir, pairs, providers, history)
  FileUtils.mkdir_p(out_dir)
  decisions_path = File.join(out_dir, DECISIONS_FILENAME)
  report_path = File.join(out_dir, REPORT_FILENAME)

  Reporting::DecisionsWriter.write(decisions_path, pairs)
  Reporting::ReportBuilder.write(report_path, pairs, providers: providers, history: history)

  [decisions_path, report_path]
end

def main(argv)
  options = parse_args(argv)
  providers = load_providers(options[:providers_path])
  operations = load_queue(options[:queue_path])
  history = Io::HistoryLoader.load(HISTORY_PATH)
  outcomes_source = build_outcome_source(options[:outcomes], providers)

  pairs = build_pairs(operations, providers, outcomes_source)
  decisions_path, report_path = write_outputs(options[:out_dir], pairs, providers, history)

  puts "Прочитано операций: #{operations.size}"
  puts "Записано: #{decisions_path}"
  puts "Записано: #{report_path}"
end

main(ARGV) if $PROGRAM_NAME == __FILE__
