#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'optparse'
require 'fileutils'
$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))
require_relative '../lib/io/providers_loader'
require_relative '../lib/io/queue_loader'
require_relative '../lib/routing/planner'
require_relative '../lib/routing/share_ledger'
require_relative '../lib/routing/strategies/volume_share'
require_relative '../lib/state/providers'
require_relative '../lib/execution/executor'
require_relative '../lib/execution/outcome_source/always_ok'
require_relative '../lib/execution/outcome_source/deterministic'
require_relative '../lib/reporting/decisions_writer'

# CLI собирает совместимые компоненты в одном месте; дробление делает поток нечитаемым.
# rubocop:disable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/MethodLength, Layout/LineLength

DECISIONS_FILENAME = 'routing_decisions_test.json'
REPORT_FILENAME = 'routing_report_test.json'

def usage
  'Использование: bin/route <queue.json> [--out-dir DIR] [--providers PATH] [--strategy NAME] [--outcomes NAME] [--seed SEED]'
end

def fail_with(message)
  warn message
  exit 1
end

def build_option_parser(options)
  OptionParser.new do |opts|
    opts.banner = usage
    opts.on('--out-dir DIR', 'Каталог для выходных файлов (по умолчанию out)') do |dir|
      options[:out_dir] = dir
    end
    opts.on('--providers PATH', 'Снапшот провайдеров') { |path| options[:providers_path] = path }
    opts.on('--strategy NAME', 'Стратегия ранжирования (count_share)') do |name|
      options[:strategy] = name
    end
    opts.on('--outcomes NAME', 'Источник исходов: deterministic или always_ok') do |name|
      options[:outcomes] = name
    end
    opts.on('--seed SEED', 'Seed детерминированного источника') { |seed| options[:seed] = seed }
  end
end

def parse_args(argv)
  options = { out_dir: 'out', providers_path: 'reference/data/providers.json', strategy: 'count_share',
              outcomes: 'deterministic', seed: '42' }
  parser = build_option_parser(options)
  remaining = parser.parse(argv)
  fail_with("Не указан файл очереди.\n#{usage}") if remaining.empty?

  options[:queue_path] = remaining.first
  options
rescue OptionParser::ParseError => e
  fail_with("Ошибка разбора аргументов: #{e.message}\n#{usage}")
end

def outcome_source(options, providers)
  case options[:outcomes]
  when 'always_ok' then Execution::OutcomeSource::AlwaysOk.new
  when 'deterministic'
    conversions = providers.to_h { |provider| [provider.name, provider.conversion_24h.to_f] }
    Execution::OutcomeSource::Deterministic.new(seed: options[:seed], conversions: conversions)
  else
    fail_with("Неизвестный источник исходов #{options[:outcomes].inspect}; допустимы deterministic, always_ok")
  end
end

def settle_share(ledger, outcome, operation)
  ledger.reserve(outcome.selected, operation)
  case outcome.result
  when :approved then ledger.commit(outcome.selected, operation)
  when :expired then ledger.hold(outcome.selected, operation)
  when :rejected then ledger.rollback(outcome.selected, operation)
  end
end

def explain_first_attempt(outcome, plan, operation, strategy, ledger)
  attempts = outcome.attempts.map do |attempt|
    first_ranked = attempt.decision == 'selected' && attempt.attempt_no == 1 && plan.candidates.size > 1
    Routing::Attempt.new(
      provider: attempt.provider.respond_to?(:name) ? attempt.provider.name : attempt.provider,
      decision: attempt.decision,
      reason: first_ranked ? 'best_target_adherence' : attempt.reason,
      details: first_ranked ? strategy.explain(plan.candidates, operation, ledger) : attempt.details,
      strategy: first_ranked ? strategy.name : attempt.strategy,
      attempt_no: attempt.attempt_no, result: attempt.result
    )
  end
  Execution::Outcome.new(selected: outcome.selected, attempts: attempts, result: outcome.result)
end

def report_period(queue)
  return nil if queue.empty?

  queue.first.created_at[0, 10]
end

def build_report(queue, strategy_name)
  {
    'period' => report_period(queue), 'total_operations' => queue.size, 'strategy' => strategy_name,
    'distribution' => {}, 'volume_distribution' => {}, 'attempt_distribution' => {}, 'skip_reasons' => {},
    'projected_daily_utilization' => {},
    'fallback' => { 'first_attempt_success' => 0, 'recovered_by_fallback' => 0, 'fallback_rate_pct' => 0.0,
                    'spacepayments_used' => 0, 'cascade_exhausted' => 0 },
    'benchmark' => { 'offline_optimum_deviation_pp' => nil, 'ours_deviation_pp' => nil, 'competitive_ratio' => nil },
    'deviation_causes' => [], 'recommendations' => []
  }
end

def write_json(path, data)
  File.write(path, "#{JSON.pretty_generate(data)}\n")
end

def main(argv)
  options = parse_args(argv)
  providers = Io::ProvidersLoader.load(options[:providers_path])
  queue_result = Io::QueueLoader.load(options[:queue_path])
  strategy = Routing::Strategies.build(options[:strategy])
  planner = Routing::Planner.new(providers: providers, strategy: strategy)
  state = State::Providers.new(providers)
  ledger = Routing::ShareLedger.new
  executor = Execution::Executor.new(outcomes: outcome_source(options, providers))

  decisions = queue_result.operations.map do |operation|
    plan = planner.plan(operation, ledger)
    outcome = executor.run(plan, operation, state)
    explained = explain_first_attempt(outcome, plan, operation, strategy, ledger)
    settle_share(ledger, explained, operation)
    Reporting::DecisionsWriter.build_decision(operation, explained)
  end

  FileUtils.mkdir_p(options[:out_dir])
  decisions_path = File.join(options[:out_dir], DECISIONS_FILENAME)
  report_path = File.join(options[:out_dir], REPORT_FILENAME)
  write_json(decisions_path, decisions)
  write_json(report_path, build_report(queue_result.operations, strategy.name))
  puts "Прочитано операций: #{queue_result.operations.size}"
  puts "Записано: #{decisions_path}"
  puts "Записано: #{report_path}"
end

main(ARGV) if $PROGRAM_NAME == __FILE__

# rubocop:enable Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/MethodLength, Layout/LineLength
