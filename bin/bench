#!/usr/bin/env ruby
# frozen_string_literal: true

# Стресс-бенчмарк с выбираемыми уровнями (Synthetic::Levels).
#
# Использование:
#   bin/bench --level LEVEL [--seed SEED] [--dir DIR] [--config PATH]
#
# Если providers/queue/expectation в DIR ещё нет — генерирует их сам (тот же
# путь, что и bin/gen), чтобы `make bench LEVEL=xl` работал одной командой.
# Гоняет только ядро (Routing::Planner + Execution::Executor) в потоковом
# режиме — decisions.json не пишется ни на одном уровне; полный CLI с записью
# файлов — bundle exec bin/route на выходе bin/gen, отдельно.

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

require 'optparse'
require 'json'
require_relative '../lib/synthetic/levels'
require_relative '../lib/synthetic/writer'
require_relative '../lib/bench/runner'
require_relative '../lib/bench/measurement'
require_relative '../lib/bench/progress'

DEFAULT_CONFIG = File.expand_path('../config/bench.yml', __dir__)

# Выше этого числа операций эталон сам не включается: память растёт линейно по
# длине очереди, а на 100 000 это уже гигабайт.
ORACLE_AUTO_MAX_OPS = 10_000
TOP_PROVIDERS = 10
TOP_SKIP_REASONS = 5

def usage
  "Использование: bin/bench --level LEVEL [--seed SEED] [--dir DIR] [--config PATH]\n" \
    "Уровни: #{Synthetic::Levels.known.join(', ')}"
end

def fail_with(message)
  warn message
  exit 1
end

def add_options(opts, options)
  opts.on('--level LEVEL', 'Имя уровня нагрузки') { |v| options[:level] = v }
  opts.on('--seed SEED', 'Seed (по умолчанию 42)') { |v| options[:seed] = v }
  add_path_options(opts, options)
  opts.on('--[no-]progress', 'Ход выполнения по этапам на STDERR (по умолчанию включён)') do |v|
    options[:progress] = v
  end
  opts.on('--[no-]oracle', 'Считать офлайн-эталон (competitive_ratio)') do |v|
    options[:oracle] = v
  end
end

def add_path_options(opts, options)
  opts.on('--dir DIR', 'Каталог со входом (по умолчанию tmp/bench/<level>)') do |v|
    options[:dir] = v
  end
  opts.on('--config PATH', 'Конфиг роутинга (по умолчанию config/bench.yml)') do |v|
    options[:config] = v
  end
end

def build_option_parser(options)
  OptionParser.new do |opts|
    opts.banner = usage
    add_options(opts, options)
  end
end

def validate_level!(name)
  return if Synthetic::Levels.known.include?(name)

  fail_with("Неизвестный уровень #{name.inspect}; допустимы: #{Synthetic::Levels.known.join(', ')}")
end

def parse_args(argv)
  options = { seed: '42', dir: nil, config: DEFAULT_CONFIG }
  build_option_parser(options).parse!(argv)
  fail_with("Не указан --level.\n#{usage}") unless options[:level]
  validate_level!(options[:level])

  options
rescue OptionParser::ParseError => e
  fail_with("Ошибка разбора аргументов: #{e.message}\n#{usage}")
end

# Пустой каталог и каталог с огрызком прошлой генерации — разные ситуации, и
# путать их нельзя: во втором случае человек обязан увидеть, что его файлы
# перезаписывают, а не гадать, почему прогон вдруг занял лишние минуты.
def input_generation_note(dir, level, seed, partial)
  suffix = "(level=#{level.name}, seed=#{seed})"
  return "генерация входа в #{dir} #{suffix}" if partial.empty?

  names = partial.map { |path| File.basename(path) }.join(', ')
  "в #{dir} неполный вход (#{names}), генерирую целиком #{suffix}"
end

def ensure_input(level, dir, seed, progress = Bench::Progress::Null.new)
  queue_path = File.join(dir, Synthetic::Writer.queue_filename(level))
  providers_path = File.join(dir, Synthetic::Writer::PROVIDERS_FILENAME)
  expectation_path = File.join(dir, Synthetic::Writer::EXPECTATION_FILENAME)
  # Проверяются ВСЕ три файла, а не только очередь. Генерация пишет их по
  # очереди, и прерывание на полуслове (Ctrl-C, OOM, кончился диск) оставляет
  # каталог с одной обрезанной queue.json. Проверка по одному файлу считала
  # такой каталог готовым, повторный запуск генерацию пропускал и падал уже на
  # чтении expectation.json — с сообщением про отсутствующий файл, которое ничего
  # не объясняет. Чинилось это только ручным rm, о котором надо догадаться.
  ready = [queue_path, providers_path, expectation_path]
  return [providers_path, queue_path, expectation_path] if ready.all? { |path| File.exist?(path) }

  progress.stage(input_generation_note(dir, level, seed, ready.select { |path| File.exist?(path) }))
  result = Synthetic::Writer.write(level_name: level.name, seed: seed, out_dir: dir)
  [result[:providers_path], result[:queue_path], result[:expectation_path]]
end

def print_report(result, level)
  print_header(result, level)
  print_oracle_note(level, !result.benchmark.nil?)
  print_benchmark(result.benchmark)
  print_analytics(result.accumulator)
  print_verdict(result.report)
end

def print_header(result, level)
  puts "\n=== #{level.name} (#{level.operations} операций, #{level.providers} провайдеров, " \
       "профиль #{level.profile}) ==="
  puts "обработано: #{result.operations_seen}"
  Bench::Measurement.format_snapshot(result.measurement, result.operations_seen).each do |line|
    puts line
  end
end

# Аналитика уже посчитана Accumulator'ом по ходу прогона (O(1) на операцию) —
# печатаем то, что и так лежит в памяти. Полный отчёт со всеми секциями пишется
# в analytics.json рядом со входными данными: в консоль лезет только сводка,
# на 500 провайдерах таблица целиком нечитаема.
def print_analytics(accumulator)
  rows = accumulator.distribution.reject { |_name, stats| stats['count'].zero? }
                    .sort_by { |_name, stats| -stats['count'] }
  return if rows.empty?

  print_distribution(rows, accumulator.attempt_distribution)
  print_skip_reasons(accumulator.skip_reasons)
  print_fallback(accumulator.fallback, accumulator.delivered, accumulator.total)
end

def print_distribution(rows, attempts)
  puts "\nраспределение (топ #{[rows.size, TOP_PROVIDERS].min} из #{rows.size} задействованных):"
  rows.first(TOP_PROVIDERS).each { |name, stats| puts analytics_row(name, stats, attempts) }
end

def analytics_row(name, stats, attempts)
  conversion = attempts.dig(name, 'observed_conversion')
  conversion_text = conversion.nil? ? '—' : format('%.3f', conversion)
  "  #{name.ljust(12)} #{stats['count'].to_s.rjust(9)} " \
    "#{format('%5.1f', stats['share_pct'])}%   конверсия #{conversion_text}"
end

def print_skip_reasons(reasons)
  return if reasons.empty?

  top = reasons.sort_by { |_reason, count| -count }.first(TOP_SKIP_REASONS)
  puts "причины отсева: #{top.map { |reason, count| "#{reason} #{count}" }.join(', ')}"
end

def print_fallback(fallback, delivered, total)
  puts "доставлено: #{delivered} из #{total} " \
       "(#{format('%.1f', total.zero? ? 0 : delivered.to_f / total * 100)}%)"
  puts "fallback: #{fallback['first_attempt_success']} с первой попытки, " \
       "#{fallback['recovered_by_fallback']} спасено каскадом, " \
       "#{fallback['spacepayments_used']} в spacepayments, " \
       "#{fallback['cascade_exhausted']} каскад исчерпан"
end

# Тот же набор секций, что в боевом routing_report_test.json, кроме тех, что
# требуют Routing::Achievable (см. комментарий в Bench::Accumulator).
def write_analytics(accumulator, dir, level, benchmark = nil)
  path = File.join(dir, 'analytics.json')
  payload = analytics_payload(accumulator, level)
  payload['benchmark'] = benchmark if benchmark
  File.write(path, "#{JSON.pretty_generate(payload)}\n")
  puts "аналитика: #{path}"
end

def analytics_payload(accumulator, level)
  {
    'level' => level.name, 'total_operations' => accumulator.total,
    'delivered' => accumulator.delivered, 'queue_errors' => accumulator.queue_errors,
    'distribution' => accumulator.distribution,
    'volume_distribution' => accumulator.volume_distribution,
    'attempt_distribution' => accumulator.attempt_distribution,
    'skip_reasons' => accumulator.skip_reasons, 'fallback' => accumulator.fallback,
    'digest' => accumulator.digest_hex
  }
end

# На потоковых уровнях оракула нет по построению: ему нужна вся очередь и все
# назначения в памяти, а ради отказа от этого потоковый режим и сделан.
def print_oracle_note(level, enabled)
  return if enabled

  reason = if level.run_oracle
             "уровень крупный, эталон держал бы все #{level.operations} пар в памяти " \
               '— включается флагом --oracle (make bench ... ORACLE=1)'
           else
             'уровень потоковый, вся очередь в память не загружается'
           end
  puts "офлайн-эталон не считается: #{reason}; проверяются конструктивные якоря"
end

def print_benchmark(benchmark)
  return if benchmark.nil?

  bound = benchmark['offline_bound']
  ours = benchmark['our_online_result']
  ratio = benchmark['competitive_ratio']
  puts "офлайн-эталон: доставлено #{bound['delivered']}, отклонение " \
       "#{bound['max_deviation_pp']} п.п.; наш прогон: доставлено #{ours['delivered']}, " \
       "отклонение #{ours['max_deviation_pp']} п.п."
  puts "competitive_ratio: #{ratio.nil? ? 'n/a' : ratio}"
end

def print_verdict(report)
  puts "точных якорей проверено: #{report.exact_checked}, расхождений: #{report.exact_failed}"
  puts "нарушений hard-constraints: #{report.hard_violations}"
  report.failures.each { |line| puts "  ✗ #{line}" }
  report.aggregate_failures.each { |line| puts "  ✗ агрегат: #{line}" }
  puts(report.ok ? 'ВЕРДИКТ: OK' : 'ВЕРДИКТ: ПРОВАЛ')
end

# Эталон держит все пары (операция, исход) в памяти — на уровне m это 1.1 ГБ
# против 170 МБ у потокового прогона. Поэтому дорогие уровни считают его только
# по явному флагу: скрытая плата памятью хуже лишней команды.
# Уровень задаёт умолчание, --oracle/--no-oracle перекрывает его в обе стороны.
def oracle_enabled?(options, level)
  return options[:oracle] unless options[:oracle].nil?

  level.run_oracle && level.operations <= ORACLE_AUTO_MAX_OPS
end

# Прогресс включён по умолчанию: уровни от m и выше идут минутами, и молчащий
# процесс неотличим от зависшего. Гасится --no-progress.
def build_progress(options, level)
  return Bench::Progress::Null.new if options[:progress] == false

  Bench::Progress.new(io: $stderr, total: level.operations)
end

def build_runner(options, level, progress)
  providers_path, queue_path, expectation_path = ensure_input(level, options[:dir_resolved],
                                                              options[:seed], progress)
  progress.stage('чтение эталона очереди')
  expectation = JSON.parse(File.read(expectation_path))
  Bench::Runner.new(providers_path: providers_path, queue_path: queue_path,
                    config_path: options[:config], expectation: expectation,
                    mode: level.mode, seed: options[:seed],
                    run_oracle: oracle_enabled?(options, level), progress: progress)
end

def run_level(options, level)
  progress = build_progress(options, level)
  result = build_runner(options, level, progress).run
  print_report(result, level)
  write_analytics(result.accumulator, options[:dir_resolved], level, result.benchmark)
  result
end

def main(argv)
  options = parse_args(argv)
  level = Synthetic::Levels.fetch(options[:level])
  options[:dir_resolved] = options[:dir] || File.join('tmp', 'bench', level.name)

  exit(run_level(options, level).report.ok ? 0 : 1)
end

main(ARGV) if $PROGRAM_NAME == __FILE__
